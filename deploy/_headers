# Netlify / Cloudflare Pages 头部配置（随 dist/ 一起发布）
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), screen-wake-lock=(self)

/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/assets/app.bundle.js
  Cache-Control: public, max-age=31536000, immutable
/assets/app.css
  Cache-Control: public, max-age=31536000, immutable
/assets/mediapipe/*
  Cache-Control: public, max-age=2592000
/assets/mediapipe/wasm/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=2592000
/assets/mediapipe/models/*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=2592000
/assets/asr/engine/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=2592000
/assets/asr/engine/*
  Cache-Control: public, max-age=2592000
/assets/asr/manifest.json
  Cache-Control: no-cache
